# Copy this file to .env and edit it, then `docker compose up -d`.
# docker compose loads .env automatically - values here become the
# CUSTOM_USER/PASSWORD used by root/custom-cont-init.d/10-lock-aegisub-auth.sh
# on first boot. See README.md "First login" for what happens if PASSWORD is
# left empty or as the placeholder below.

CUSTOM_USER=admin
PASSWORD=changeme_on_first_run
